(* Generated by jsonschema2atd from preprocessed_schema.json *)
type json <ocaml module="Yojson.Basic" t="t"> = abstract
type int64 = int <ocaml repr="int64">

type test_caseValidation = [
  | Parse <json name="parse">
  | Parse_value <json name="parse_value">
  | Filter <json name="filter">
  | Compose <json name="compose">
  | Expand_dotted <json name="expand_dotted">
  | Build_hierarchy <json name="build_hierarchy">
  | Get_string <json name="get_string">
  | Get_int <json name="get_int">
  | Get_bool <json name="get_bool">
  | Get_float <json name="get_float">
  | Get_list <json name="get_list">
  | Canonical_format <json name="canonical_format">
  | Load <json name="load">
  | Round_trip <json name="round_trip">
  | Associativity <json name="associativity">
] <doc text="Single CCL function to validate">

type test_caseFunctions = [
  | Parse <json name="parse">
  | Parse_value <json name="parse_value">
  | Filter <json name="filter">
  | Compose <json name="compose">
  | Expand_dotted <json name="expand_dotted">
  | Build_hierarchy <json name="build_hierarchy">
  | Get_string <json name="get_string">
  | Get_int <json name="get_int">
  | Get_bool <json name="get_bool">
  | Get_float <json name="get_float">
  | Get_list <json name="get_list">
  | Canonical_format <json name="canonical_format">
  | Load <json name="load">
  | Round_trip <json name="round_trip">
  | Associativity <json name="associativity">
] 

type test_caseBehaviors = [
  | Boolean_strict <json name="boolean_strict">
  | Boolean_lenient <json name="boolean_lenient">
  | Crlf_preserve_literal <json name="crlf_preserve_literal">
  | Crlf_normalize_to_lf <json name="crlf_normalize_to_lf">
  | Tabs_preserve <json name="tabs_preserve">
  | Tabs_to_spaces <json name="tabs_to_spaces">
  | Strict_spacing <json name="strict_spacing">
  | Loose_spacing <json name="loose_spacing">
  | List_coercion_enabled <json name="list_coercion_enabled">
  | List_coercion_disabled <json name="list_coercion_disabled">
] 

type test_caseVariants = [
  | Proposed_behavior <json name="proposed_behavior">
  | Reference_compliant <json name="reference_compliant">
] 

type test_caseFeatures = [
  | Comments <json name="comments">
  | Empty_keys <json name="empty_keys">
  | Experimental_dotted_keys <json name="experimental_dotted_keys">
  | Multiline <json name="multiline">
  | Unicode <json name="unicode">
  | Whitespace <json name="whitespace">
] 

type test_caseConflicts = {
  ?functions : string list option;
  ?behaviors : string list option;
  ?variants : string list option;
  ?features : string list option;
} <doc text="Mutually exclusive options by category">

type test_case = {
  name <doc text="Unique test name (source_name + validation function)">: string;
  input <doc text="CCL input text to be tested">: string;
  validation <doc text="Single CCL function to validate">: test_caseValidation;
  expected <doc text="Expected test results with flexible structure">: json;
  ?args <doc text="Arguments for typed access functions (get_string, get_int, get_bool, get_float, get_list). Required for these functions, omitted for others.">: string list option;
  ?functions <doc text="CCL functions tested by this test">: test_caseFunctions list option;
  behaviors <doc text="Implementation behavior choices">: test_caseBehaviors list;
  variants <doc text="Specification variants">: test_caseVariants list;
  features <doc text="Required language features">: test_caseFeatures list;
  ?conflicts <doc text="Mutually exclusive options by category">: test_caseConflicts option;
  ?requires <doc text="Functions that must be implemented as prerequisites">: string list option;
  ?level <doc text="CCL implementation level (1-5)">: int option;
  ?source_test <doc text="Original source test name for traceability">: string option;
  ~expect_error <doc text="Whether this test should produce an error"> <ocaml default="false">: bool;
  ?error_type <doc text="Expected error type for error tests">: string option;
} 

type test_suite = {
  schema <json name="$schema"> <doc text="JSON Schema reference">: string;
  tests : test_case list;
} <doc text="Schema for existing generated flat test files (star-flat.json)">

type root = test_case list
