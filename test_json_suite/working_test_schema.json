{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["name", "input", "validation"],
    "properties": {
      "name": {
        "type": "string"
      },
      "input": {
        "type": "string"
      },
      "validation": {
        "type": "string",
        "enum": [
          "parse", "parse_value", "filter", "compose", "expand_dotted",
          "build_hierarchy", "get_string", "get_int", "get_bool", "get_float", "get_list",
          "pretty_print", "load", "round_trip", "canonical_format", "associativity"
        ]
      },
      "expected_count": {
        "type": "integer",
        "minimum": 0
      },
      "expected_entries": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["key", "value"],
          "properties": {
            "key": {"type": "string"},
            "value": {"type": "string"}
          }
        }
      }
    }
  }
}